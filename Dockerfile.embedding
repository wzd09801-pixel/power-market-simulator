FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
WORKDIR /app

COPY requirements-embedding.txt ./
RUN --mount=type=cache,target=/root/.cache/pip pip install -r requirements-embedding.txt
COPY embedding_service ./embedding_service

EXPOSE 8090
CMD ["uvicorn", "embedding_service.app:app", "--host", "0.0.0.0", "--port", "8090"]
