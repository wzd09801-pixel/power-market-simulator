APP_NAME=Power Market Simulator
APP_VERSION=0.1.0
ENVIRONMENT=development
LOG_LEVEL=INFO

DATABASE_URL=postgresql+psycopg://power:power@db:5432/power_market
API_BASE_URL=http://localhost:8000

POSTGRES_DB=power_market
POSTGRES_USER=power
POSTGRES_PASSWORD=power
POSTGRES_PORT=5432
API_PORT=8000
COCKPIT_PORT=3000

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=power-market-raw
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

PREFECT_API_URL=http://prefect-server:4200/api
PREFECT_WORK_POOL=local-workstation
OPERATION_WORKER_POLL_SECONDS=2
OPERATION_WORKER_LEASE_SECONDS=300
OPERATION_WORKER_RETRY_DELAY_SECONDS=60

EMBEDDING_SERVICE_URL=http://embedding-service:8090
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

DEEPSEEK_API_KEY=
DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions
DEEPSEEK_DEFAULT_MODEL=deepseek-v4-flash
DEEPSEEK_DEEP_ANALYSIS_MODEL=deepseek-v4-pro
DEEPSEEK_TIMEOUT_SECONDS=30
DEEPSEEK_MAX_RETRIES=2

QWEATHER_API_HOST=
QWEATHER_API_KEY=
AMAP_WEATHER_KEY=

OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_TIMEOUT_SECONDS=10
OPEN_METEO_MAX_RETRIES=2
OPEN_METEO_RETRY_BACKOFF_SECONDS=0.25

MARKET_HEALTH_TIMEOUT_SECONDS=5
MARKET_HEALTH_MAX_RETRIES=1
MARKET_HEALTH_RETRY_BACKOFF_SECONDS=0.25
MARKET_HEALTH_MIN_INTERVAL_SECONDS=30

BENCH_DISPATCH_TIMEOUT_SECONDS=20
BENCH_DISPATCH_MAX_RETRIES=2
BENCH_DISPATCH_RETRY_BACKOFF_SECONDS=0.5
