{
  "package_version": "first_data_day_package_v1",
  "package_name": "Zero-data first data day placeholder package",
  "template_mode": true,
  "description": "Template-only manifest for future local data. Paths are placeholders until the operator receives real files.",
  "safety": {
    "no_auto_trading": true,
    "external_model_call": false,
    "model_promotion": false,
    "database_write": false,
    "network_access": false,
    "docker_required": false
  },
  "capability_defaults": {
    "rag_answering_enabled": false,
    "forecast_training_enabled": false,
    "backtest_enabled": false,
    "recommendation_mode": "scenario_simulated_only",
    "external_model_call": false,
    "no_auto_trading": true
  },
  "recommendation_boundaries": {
    "data_mode_until_reviewed_evidence": "scenario_simulated",
    "human_review_required": true,
    "research_only_evidence_allowed": false,
    "no_auto_trading": true
  },
  "files": [
    {
      "entry_id": "forecast_curve_csv_placeholder",
      "relative_path": "forecast/forecast_research_curve_placeholder.csv",
      "file_type": "csv",
      "target_workflow": "forecast_research_curve",
      "required_columns": ["interval_start", "price"],
      "metadata": {
        "data_mode": "user_uploaded",
        "source_name": "Operator prepared local CSV",
        "source_url": null,
        "source_timestamp": null,
        "timezone": "Asia/Shanghai",
        "unit": "CNY_per_MWh",
        "permission": "local_operator_upload",
        "visibility_scope": "local_only",
        "human_review_required": true,
        "usage_scope": "research_only",
        "interval_minutes": 15,
        "price_unit": "CNY_per_MWh",
        "no_auto_trading": true
      }
    },
    {
      "entry_id": "forecast_dataset_json_placeholder",
      "relative_path": "forecast/forecast_research_dataset_placeholder.json",
      "file_type": "json",
      "target_workflow": "forecast_dataset_manifest",
      "required_fields": [
        "name",
        "source_name",
        "source_url",
        "interval_minutes",
        "timezone",
        "price_unit",
        "data_mode",
        "usage_scope",
        "points"
      ],
      "metadata": {
        "data_mode": "user_uploaded",
        "source_name": "Operator prepared local JSON",
        "source_url": null,
        "source_timestamp": null,
        "timezone": "Asia/Shanghai",
        "unit": "CNY_per_MWh",
        "permission": "local_operator_upload",
